generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  NEW
  USED
  GIFT
  DIGITAL
}

enum ProductCondition {
  GOOD
  DETAILS
  DAMAGED
}

enum ProductStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  GIVEN_AWAY
  HIDDEN
}

model Product {
  id                String            @id @default(uuid())
  slug              String            @unique
  title             String
  description       String
  type              ProductType
  category          String
  condition         ProductCondition?
  damageDetails     String?
  priceCop          Int?
  stock             Int               @default(1)
  acceptsOffers     Boolean           @default(false)
  status            ProductStatus     @default(AVAILABLE)
  deliveryArea      String?
  videoUrl          String?
  allowWompiPayment Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  images            ProductImage[]

  @@index([type, status])
  @@index([status])
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  storagePath String
  sortOrder   Int      @default(0)
  altText     String?
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model StoreSettings {
  id                  String   @id @default("default")
  storeName           String   @default("DE SEGUNDA")
  tagline             String   @default("Cosas buenas para alguien más.")
  whatsappNumber      String   @default("573137751715")
  defaultDeliveryArea String   @default("Cartagena de Indias")
  logoPath            String?
  updatedAt           DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
